[Unit]
Description=Frameworks {{ go_service_name }}
After=network-online.target
Wants=network-online.target

[Service]
User={{ go_service_user }}
Group={{ go_service_group }}
WorkingDirectory={{ go_service_install_dir }}
EnvironmentFile={{ go_service_env_file }}
ExecStart={{ ([go_service_install_dir ~ '/' ~ go_service_name] + (go_service_args | default([]))) | map('quote') | join(' ') }}
{% if go_service_supports_sighup_reload | default(false) | bool %}
ExecReload=/bin/kill -HUP $MAINPID
{% endif %}
Restart=always
RestartSec=5
LimitNOFILE=1048576
{% if go_service_sandbox | default(false) | bool %}
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
UMask=0077
{% if go_service_state_dirs | default([]) | length > 0 %}
ReadWritePaths={{ go_service_state_dirs | join(' ') }}
{% endif %}
{% endif %}

[Install]
WantedBy=multi-user.target
