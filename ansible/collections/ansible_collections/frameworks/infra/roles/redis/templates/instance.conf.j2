# Declared settings for {{ redis_service_name }}, rendered by provisioning.
# The server runs from {{ redis_runtime_config_path }}, which includes this
# file and carries the live replication role (replicaof) written by
# Sentinel/CONFIG REWRITE. Replication role is never declared here.
bind {{ redis_bind_interface }}
port {{ redis_port }}
{% set redis_bind_addresses = redis_bind_interface.split() %}
{% set redis_loopback_only = (redis_bind_addresses | difference(['127.0.0.1', '::1', 'localhost'])) | length == 0 %}
protected-mode {{ 'yes' if (redis_password | length > 0) or redis_loopback_only else 'no' }}
supervised systemd
daemonize no
timeout 300

dir {{ redis_data_dir }}
dbfilename dump.rdb
appendonly {{ redis_appendonly }}
appendfsync everysec

loglevel notice
logfile {{ redis_log_file }}
pidfile /run/{{ redis_service_name }}/redis.pid
databases 16

maxmemory {{ redis_maxmemory }}
maxmemory-policy noeviction

{% if redis_password | length > 0 %}
requirepass {{ redis_password }}
{# Every server carries masterauth: Sentinel can demote any of them to a
   replica, and a demoted primary without it cannot sync (NOAUTH). #}
masterauth {{ redis_password }}
{% endif %}
