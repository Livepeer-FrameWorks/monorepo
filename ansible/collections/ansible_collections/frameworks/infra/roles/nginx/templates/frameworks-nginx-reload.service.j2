[Unit]
Description=Reload nginx after Privateer rotates ingress TLS material
{% if nginx_ingress_reload_mode == 'docker' %}
After=docker.service
Requires=docker.service
{% else %}
After={{ nginx_service_name }}.service
Requires={{ nginx_service_name }}.service
{% endif %}

[Service]
Type=oneshot
RuntimeDirectory=frameworks-nginx
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStart=/usr/local/libexec/frameworks-nginx-reload
