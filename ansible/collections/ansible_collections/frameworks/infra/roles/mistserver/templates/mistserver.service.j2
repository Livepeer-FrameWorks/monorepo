[Unit]
Description=FrameWorks MistServer (edge media server)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ mistserver_user }}
Group={{ mistserver_group }}
WorkingDirectory={{ mistserver_install_dir }}/bin
EnvironmentFile={{ mistserver_env_file }}
Environment=MIST_LOG_SYSTEMD=1
Environment=LD_LIBRARY_PATH={{ mistserver_install_dir }}/opt/mist-onnx/lib:{{ mistserver_install_dir }}/lib:{{ mistserver_install_dir }}/lib/x86_64-linux-gnu:{{ mistserver_install_dir }}/lib/aarch64-linux-gnu:/opt/mist-onnx/lib
ExecStartPre=+/bin/bash -c "rm -f /dev/shm/Mst* /dev/shm/sem.MstSemStat"
# Seeds MIST_API_USERNAME/MIST_API_PASSWORD from the EnvironmentFile into the
# config, so the password never appears on MistController's command line.
ExecStartPre=+{{ mistserver_account_seed_python }} {{ mistserver_account_seed_script }} {{ mistserver_config_file }} {{ mistserver_user }} {{ mistserver_group }}
ExecStart={{ mistserver_install_dir }}/bin/MistController -c {{ mistserver_config_file }}
ExecStopPost=+/bin/bash -c "rm -f /dev/shm/Mst* /dev/shm/sem.MstSemStat"
ExecReload=/bin/kill -s USR1 $MAINPID
Restart=always
RestartSec=2
TasksMax=infinity
TimeoutStopSec=8
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
