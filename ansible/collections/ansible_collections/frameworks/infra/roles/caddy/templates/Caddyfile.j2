{
{% if caddy_global_options.email | default('') | length > 0 %}
    email {{ caddy_global_options.email }}
{% endif %}
    admin {{ caddy_admin_listen }}
{# Global, not per-site: a site log directive covers access logs only, while
   upstream failures come from the default logger and carry the full request
   URI — which for /webrtc/<streamKey> and /ingest/<streamKey> is a publishing
   credential. #}
    log {
        format filter {
            wrap json
            fields {
                request>uri regexp "/(webrtc|ingest)/[^/?]+" "/${1}/REDACTED"
            }
        }
    }
}

{% for site in caddy_sites %}
{# www.X hosts whose apex X is also served get canonicalizing 301s instead of
   duplicate content; the site cert's SANs cover both names. Explicitly
   tls-off sites are http-only, so there is no https target to redirect to. #}
{% set ns = namespace(www_hosts=[]) %}
{% if site.tls_mode | default('') != 'off' %}
{% for domain in site.domains %}
{% if domain.startswith('www.') and domain[4:] in site.domains %}
{% set ns.www_hosts = ns.www_hosts + [domain] %}
{% endif %}
{% endfor %}
{% endif %}
{% set main_domains = site.domains | reject('in', ns.www_hosts) | list %}
{% for www_host in ns.www_hosts %}
{{ www_host }} {
{% if site.tls_mode | default('') == 'off' %}
    tls off
{% elif site.tls_mode | default('') == 'internal' %}
    tls internal
{% elif site.tls_mode | default('') == 'files' and site.tls_cert_path | default('') | length > 0 and site.tls_key_path | default('') | length > 0 %}
    tls {{ site.tls_cert_path }} {{ site.tls_key_path }}
{% endif %}
    redir https://{{ www_host[4:] }}{uri} permanent
}

{% endfor %}
{{ main_domains | join(', ') }} {
{% if site.tls_mode | default('') == 'off' %}
    tls off
{% elif site.tls_mode | default('') == 'internal' %}
    tls internal
{% elif site.tls_mode | default('') == 'files' and site.tls_cert_path | default('') | length > 0 and site.tls_key_path | default('') | length > 0 %}
    tls {{ site.tls_cert_path }} {{ site.tls_key_path }}
{% endif %}
{% if site.tls_mode | default('') != 'off' %}
    header Strict-Transport-Security "max-age=31536000"
{% endif %}
{# Keep browser-visible deployment config immediately replaceable during
   provider changes and key rotation, without widening restricted routes. #}
{% set runtime_config = namespace(served=false) %}
{% if site.path_prefixes | default([]) | length == 0 %}
{% set runtime_config.served = true %}
{% else %}
{% for path_prefix in site.path_prefixes %}
{% if path_prefix | length > 0 and '/runtime-config.js'.startswith(path_prefix) %}
{% set runtime_config.served = true %}
{% endif %}
{% endfor %}
{% endif %}
{% if runtime_config.served and site.profile | default('api') != 'media_ingest' %}
    @runtime_config path /runtime-config.js
    header @runtime_config {
        Cache-Control "no-store"
        -Expires
    }
{% endif %}
{% if site.upstream is defined and site.upstream | length > 0 %}
{% if site.profile | default('api') == 'media_ingest' %}
    @media_ingest {
        path /live /live/*
        method POST PUT
    }
    reverse_proxy @media_ingest {{ site.upstream }} {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
    }
    respond 404
{% else %}
{% if site.path_prefixes | default([]) | length > 0 %}
{% for path_prefix in site.path_prefixes %}
{% if (site.upstream | string | lower).startswith('https://') %}
    reverse_proxy {{ path_prefix }} {{ site.upstream }} {
        header_up Host {upstream_hostport}
    }
{% else %}
    reverse_proxy {{ path_prefix }} {{ site.upstream }}
{% endif %}
{% endfor %}
{% else %}
{% if (site.upstream | string | lower).startswith('https://') %}
    reverse_proxy {{ site.upstream }} {
        header_up Host {upstream_hostport}
    }
{% else %}
    reverse_proxy {{ site.upstream }}
{% endif %}
{% endif %}
{% endif %}
{% endif %}
{% for directive in site.extra_directives | default([]) %}
    {{ directive }}
{% endfor %}
}

{% endfor %}
