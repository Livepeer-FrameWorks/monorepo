{# Routing: Lookout receives every alert group (firing and resolved) and owns
   incidents, acknowledgement and operator notifications. Critical alerts also
   page by direct email so a Lookout outage cannot silence them. The always-
   firing Watchdog alert goes only to the external heartbeat, which alarms when
   its pings stop and so detects a dead alerting pipeline.

   Alertmanager uses the parent receiver only when no child route matches, so
   the trailing matcher-less route is what delivers critical alerts to Lookout
   after the email route continues past them. Groups split by alertname,
   region and cluster; Lookout derives one incident's scope from its cluster,
   so a group never mixes clusters owned by different tenants. #}
global:
  resolve_timeout: 5m
  smtp_smarthost: {{ alertmanager_smtp_smarthost | to_json }}
  smtp_from: {{ alertmanager_smtp_from | to_json }}
{% if alertmanager_smtp_auth_username | length > 0 %}
  smtp_auth_username: {{ alertmanager_smtp_auth_username | to_json }}
  smtp_auth_password: {{ alertmanager_smtp_auth_password | to_json }}
{% endif %}
  smtp_require_tls: true

route:
  receiver: lookout
  group_by: [alertname, region, cluster]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    - receiver: heartbeat
      matchers:
        - alertname="Watchdog"
      group_wait: 0s
      group_interval: 1m
      repeat_interval: 1m
    - receiver: email-fallback
      matchers:
        - severity="critical"
      repeat_interval: 1h
      continue: true
    - receiver: lookout

inhibit_rules:
  - source_matchers:
      - severity="critical"
    target_matchers:
      - severity="warning"
    equal: [alertname, region, cluster]

receivers:
  - name: lookout
    webhook_configs:
      - url: {{ alertmanager_lookout_url | to_json }}
        send_resolved: true
        http_config:
          authorization:
            type: Bearer
            credentials: {{ alertmanager_lookout_token | to_json }}
  - name: email-fallback
    email_configs:
      - to: {{ alertmanager_email_to | to_json }}
        send_resolved: true
  - name: heartbeat
    webhook_configs:
      - url: {{ alertmanager_heartbeat_url | to_json }}
        send_resolved: false
