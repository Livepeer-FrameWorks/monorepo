node.id={{ kafka_node_id }}
{% if kafka_role == 'controller' %}
process.roles=controller
listeners=CONTROLLER://{{ kafka_bind_host }}:{{ kafka_controller_port }}
controller.listener.names=CONTROLLER
{% elif kafka_role == 'broker' %}
process.roles=broker
listeners=PLAINTEXT://{{ kafka_bind_host }}:{{ kafka_broker_port }}
advertised.listeners=PLAINTEXT://{{ kafka_advertised_host }}:{{ kafka_broker_port }}
controller.listener.names=CONTROLLER
{% else %}
process.roles=broker,controller
listeners=PLAINTEXT://{{ kafka_bind_host }}:{{ kafka_broker_port }},CONTROLLER://{{ kafka_bind_host }}:{{ kafka_controller_port }}
advertised.listeners=PLAINTEXT://{{ kafka_advertised_host }}:{{ kafka_broker_port }}
controller.listener.names=CONTROLLER
{% endif %}
listener.security.protocol.map=PLAINTEXT:PLAINTEXT,CONTROLLER:PLAINTEXT
inter.broker.listener.name=PLAINTEXT
controller.quorum.voters={{ kafka_voters }}
log.dirs={{ kafka_role_data_dir }}
num.network.threads=3
num.io.threads=8
socket.send.buffer.bytes=102400
socket.receive.buffer.bytes=102400
socket.request.max.bytes=104857600
num.partitions=1
num.recovery.threads.per.data.dir=1
min.insync.replicas={{ kafka_min_insync_replicas }}
offsets.topic.replication.factor={{ kafka_offsets_topic_replication_factor }}
transaction.state.log.replication.factor={{ kafka_transaction_state_log_replication_factor }}
transaction.state.log.min.isr={{ kafka_transaction_state_log_min_isr }}
log.retention.hours=168
log.retention.bytes={{ kafka_log_retention_bytes }}
log.segment.bytes={{ kafka_log_segment_bytes }}
log.retention.check.interval.ms=300000
{% if kafka_role != 'broker' %}
# The KRaft I/O thread fsyncs the metadata log and quorum-state on every
# append and vote, so a storage stall freezes the leader and every voter at
# once. At the stock 2 s fetch / 1 s election timeouts a stall of a few
# seconds makes every voter abandon a healthy leader, and the elections that
# follow need the same stalled fsyncs, leaving the quorum leaderless. A crashed
# leader is still replaced after fetch.timeout; a graceful shutdown resigns
# immediately. Brokers keep the stock observer timeouts so they find a new
# leader before broker.session.timeout.ms fences them.
controller.quorum.fetch.timeout.ms={{ kafka_quorum_fetch_timeout_ms }}
controller.quorum.election.timeout.ms={{ kafka_quorum_election_timeout_ms }}
{% endif %}
