[Unit]
Description=Apache Kafka ({{ kafka_role }})
After=network-online.target
Wants=network-online.target

[Service]
User={{ kafka_user }}
Group={{ kafka_group }}
Environment="KAFKA_HEAP_OPTS={{ kafka_heap_opts }}"
Environment="LOG_DIR={{ kafka_role_log_dir }}"
Environment="KAFKA_LOG4J_OPTS=-Dlog4j2.configurationFile={{ kafka_log4j_path }}"
Environment="KAFKA_OPTS=-javaagent:{{ kafka_jmx_exporter_jar }}=127.0.0.1:{{ kafka_jmx_port }}:{{ kafka_jmx_exporter_config_path }}"
{# kafka-run-class.sh defaults KAFKA_JMX_OPTS to an unauthenticated, plaintext
   JMX agent whose RMI ports listen on every interface. The JMX exporter runs in-process
   as a javaagent bound to loopback, so the JVM starts without the remote agent. #}
Environment="KAFKA_JMX_OPTS=-Djava.awt.headless=true"
ExecStart={{ kafka_bin_dir }}/kafka-server-start.sh {{ kafka_properties_path }}
ExecStop={{ kafka_bin_dir }}/kafka-server-stop.sh
Restart=always
RestartSec=5
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
