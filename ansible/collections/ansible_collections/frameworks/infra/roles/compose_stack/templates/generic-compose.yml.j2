services:
  {{ compose_stack_name }}:
    image: {{ compose_stack_service.image }}
    container_name: frameworks-{{ compose_stack_name }}
    restart: always
    # Covers pkg/server's 65 s pre-stop readiness delay plus its 30 s
    # shutdown timeout (TestPreStopDelayCoversPollersAndFitsStopBudget).
    stop_grace_period: 2m
    logging:
      driver: local
      options:
        max-size: "50m"
        max-file: "5"
{% if compose_stack_env | default({}) | length > 0 %}
    env_file:
      - .env
{% endif %}
{% if compose_stack_service.extra_hosts | default([]) | length > 0 %}
    extra_hosts:
{% for extra_host in compose_stack_service.extra_hosts %}
      - "{{ extra_host }}"
{% endfor %}
{% endif %}
{% if compose_stack_service.ports | default([]) | length > 0 %}
    ports:
{% for published in compose_stack_service.ports %}
{% set container_port = published.container_port | default(published.port) %}
{% if published.addrs | default([]) | length > 0 %}
{% for addr in published.addrs %}
      - "{{ addr }}:{{ published.port }}:{{ container_port }}"
{% endfor %}
{% else %}
      - "{{ published.port }}:{{ container_port }}"
{% endif %}
{% endfor %}
{% endif %}
{% if compose_stack_pki_gid | default('') | string | length > 0 %}
    group_add:
      - "{{ compose_stack_pki_gid }}"
{% endif %}
{% if compose_stack_service.volumes | default([]) | length > 0 %}
    volumes:
{% for volume in compose_stack_service.volumes %}
      - "{{ volume }}"
{% endfor %}
{% endif %}
    networks:
      - frameworks
networks:
  frameworks:
    driver: bridge
