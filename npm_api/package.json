{
  "name": "@livepeer-frameworks/api",
  "version": "0.2.0",
  "type": "module",
  "description": "Typed client for the FrameWorks GraphQL API: operations, retries, pagination, typed errors, uploads, playback tokens, and webhooks",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./subscriptions": {
      "source": "./src/subscriptions.ts",
      "types": "./dist/subscriptions.d.ts",
      "default": "./dist/subscriptions.js"
    },
    "./webhooks": {
      "source": "./src/webhooks.ts",
      "types": "./dist/webhooks.d.ts",
      "default": "./dist/webhooks.js"
    },
    "./gateway-probe": {
      "source": "./src/gatewayProbe.ts",
      "types": "./dist/gatewayProbe.d.ts",
      "default": "./dist/gatewayProbe.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "codegen": "graphql-codegen --config codegen.ts && node codegen/descriptions.mjs",
    "type-check": "tsc -p tsconfig.json --noEmit && tsc -p examples/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "^3.2.0",
    "graphql": "^16.13.2",
    "standardwebhooks": "^1.1.1"
  },
  "peerDependencies": {
    "graphql-ws": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "graphql-ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@graphql-codegen/add": "^7.1.0",
    "@graphql-codegen/cli": "^7.4.1",
    "@graphql-codegen/typed-document-node": "^7.1.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.6",
    "@types/node": "^25.6.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.2.0",
    "graphql-ws": "^6.0.8",
    "ts-proto": "^2.12.4",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.4",
    "ws": "^8.18.3"
  },
  "keywords": [
    "frameworks",
    "livepeer",
    "graphql",
    "streaming",
    "sdk"
  ],
  "author": "Livepeer FrameWorks",
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Livepeer-FrameWorks/monorepo.git",
    "directory": "npm_api"
  }
}
