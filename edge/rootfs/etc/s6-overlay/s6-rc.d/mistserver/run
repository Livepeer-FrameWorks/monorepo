#!/command/with-contenv sh
# Parity with the native unit's ExecStartPre: stale shared-memory pages from
# a previous MistController would wedge the new one.
rm -f /dev/shm/Mst* /dev/shm/sem.MstSemStat 2>/dev/null || true
export LD_LIBRARY_PATH=/opt/frameworks/mistserver/opt/mist-onnx/lib:/opt/frameworks/mistserver/lib:/opt/frameworks/mistserver/lib/x86_64-linux-gnu:/opt/frameworks/mistserver/lib/aarch64-linux-gnu:/opt/mist-onnx/lib
# MistController takes its API account from MIST_API_USERNAME (default
# frameworks) and MIST_API_PASSWORD in the container environment (kept by
# S6_KEEP_ENV) and removes both from its environment before starting anything;
# the password is never passed on the command line, where the process list
# would expose it.
exec s6-setuidgid frameworks /opt/frameworks/mistserver/bin/MistController \
  -c /etc/frameworks/mistserver.conf
