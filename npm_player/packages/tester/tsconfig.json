{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "paths": {
      "@livepeer-frameworks/player-core": ["../core/src/index.ts"],
      "@livepeer-frameworks/player-react": ["../react/src/index.tsx"]
    }
  },
  "include": ["src/**/*", "test/**/*", "../react/src/global.d.ts"],
  "exclude": ["node_modules"]
}
