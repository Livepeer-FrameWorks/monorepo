{
  "name": "@livepeer-frameworks/player-tester",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stream tester shared by the SDK playground and the FrameWorks /stream-test page",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tester.css": "./src/tester.css"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@livepeer-frameworks/player-core": "workspace:*",
    "@livepeer-frameworks/player-react": "workspace:*",
    "@livepeer-frameworks/streamcrafter-react": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.4",
    "jsdom": "^29.0.2",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "author": "Livepeer FrameWorks",
  "license": "Unlicense"
}
