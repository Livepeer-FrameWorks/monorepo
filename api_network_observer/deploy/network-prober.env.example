NETWORK_OBSERVER_URL=https://observer.example.net
NETWORK_OBSERVER_SECRET=replace-with-shared-secret
NETWORK_PROBER_ID=eu-observer-1
NETWORK_PROBER_REGION=eu-west
NETWORK_PROBER_SPOOL_DIR=/var/lib/frameworks-network-prober
# Put the existing funded broadcaster address/signature pair in
# /etc/frameworks/network-prober.identity.env, or generate that file offline
# with: network-prober sign-discovery --keystore FILE --password-file FILE --output FILE
LIVEPEER_DISCOVERY_SKIP_TLS_VERIFY=true
