            "status": 422,
            "body": {
              "data": null,
              "errors": [
                {
                  "message": "Cannot query field \"serverInfo\" on type \"Query\".",
                  "extensions": { "code": "GRAPHQL_VALIDATION_FAILED" }
                }
              ]
            }
          }
        ],
        "DeleteStream": []
      },
      "calls": ["DeleteStream"],
      "expect": {
        "calls": [
          {
            "error": {
              "kind": "ServerTooOldError",
              "serverVersion": null,
              "minimumVersion": "v0.3.11"
            }
          }
        ],
        "sent": { "ServerInfo": 1, "DeleteStream": 0 }
      }
    },
