{
  "description": "The serverInfo gate. Each case builds one client (minimum server v0.3.11 unless minServer is set) on a scripted transport that answers each operation name from its own queue, and makes the listed calls in order; a calls entry {advanceMs} moves the client's clock forward instead of making a call. A stable server version vMAJOR.MINOR.PATCH below the minimum is ServerTooOldError; so is a server whose schema lacks serverInfo. Any other version string (dev, git describe, release candidates) is unverified and passes every check. A network failure of the probe is not too old: the call proceeds and the next call probes again. A probe answer is cached for the client's URL for five minutes (300000 ms), then probed again. A cached answer that would fail a call as too old is probed again first, and an operation that fails with a schema validation error probes again at once: when the fresh answer fails the check the call fails with that verdict, otherwise with the schema error. An HTTP 402 answer to serverInfo (a v0.3.10 gateway answers an anonymous serverInfo with its x402 payment challenge, because the field is not on its public allowlist) is not a verdict: calls proceed unchecked, and the 402 is cached like an answer so the gateway is not probed again for five minutes. Cases with scope client exercise the client's operation path and do not apply to a probe alone. An operation whose since is above a verified server version is UnsupportedOperationError; operationSince overrides the manifest for the case. Mutations and operations whose since is above the minimum are never sent before the probe settles; other queries may be sent alongside the probe, but a failed check still fails the call. Retries are off. expect.calls gives, per call, ok or the error; expect.sent counts the requests per operation name.",
  "cases": [
    {
      "name": "a stable server at the minimum passes and is probed once",
      "responses": {
        "ServerInfo": [
          {
            "status": 200,
            "body": { "data": { "serverInfo": { "version": "v0.3.11", "features": [] } } }
          }
        ],
        "GetStream": [
          { "status": 200, "body": { "data": { "stream": null } } },
          { "status": 200, "body": { "data": { "stream": null } } }
        ]
      },
      "calls": ["GetStream", "GetStream"],
      "expect": {
        "calls": [{ "ok": true }, { "ok": true }],
        "sent": { "ServerInfo": 1, "GetStream": 2 },
        "serverVersion": "v0.3.11",
        "verified": true
      }
    },
    {
      "name": "a newer server passes",
      "responses": {
        "ServerInfo": [
          {
            "status": 200,
            "body": { "data": { "serverInfo": { "version": "v0.4.2", "features": [] } } }
          }
        ],
        "GetStream": [{ "status": 200, "body": { "data": { "stream": null } } }]
      },
      "calls": ["GetStream"],
      "expect": {
        "calls": [{ "ok": true }],
        "sent": { "ServerInfo": 1, "GetStream": 1 },
        "verified": true
      }
    },
    {
      "name": "a stable server below the minimum is too old and the mutation is not sent",
      "responses": {
        "ServerInfo": [
          {
            "status": 200,
            "body": { "data": { "serverInfo": { "version": "v0.3.10", "features": [] } } }
          }
        ],
        "DeleteStream": []
      },
      "calls": ["DeleteStream"],
      "expect": {
        "calls": [
          {
            "error": {
              "kind": "ServerTooOldError",
              "serverVersion": "v0.3.10",
              "minimumVersion": "v0.3.11"
            }
          }
        ],
        "sent": { "ServerInfo": 1, "DeleteStream": 0 }
      }
    },
    {
      "name": "a too-old server fails queries too",
      "responses": {
        "ServerInfo": [
          {
            "status": 200,
            "body": { "data": { "serverInfo": { "version": "v0.3.9", "features": [] } } }
          }
        ],
        "GetStream": [{ "status": 200, "body": { "data": { "stream": null } } }]
      },
      "calls": ["GetStream"],
      "expect": {
        "calls": [
          {
            "error": {
              "kind": "ServerTooOldError",
              "serverVersion": "v0.3.9",
              "minimumVersion": "v0.3.11"
            }
          }
        ]
      }
    },
    {
      "name": "a server without serverInfo is too old",
      "responses": {
