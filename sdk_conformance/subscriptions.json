                "subject": "streams/5b0e6a2c",
                "data": {
                  "__typename": "StreamLive",
                  "streamId": "5b0e6a2c"
                }
              }
            }
          ],
          "then": "drop",
          "dropCode": 1001
        },
        {
          "onInit": "ack",
          "next": [
            {
              "tenantEvents": {
                "id": "evt-21",
                "type": "stream.live",
                "time": "2026-09-19T14:05:00Z",
                "subject": "streams/5b0e6a2c",
                "data": {
                  "__typename": "StreamLive",
