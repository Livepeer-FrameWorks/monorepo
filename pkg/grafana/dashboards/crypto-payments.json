  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Open accounting anomalies",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "targets": [
        { "refId": "A", "expr": "sum(purser_crypto_accounting_anomalies)", "legendFormat": "open" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto"
      }
    },
