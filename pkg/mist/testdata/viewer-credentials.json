{
  "config": {
    "device_discovery": false,
    "tknMode": 15,
    "sessionViewerMode": 14,
    "protocols": [
      { "connector": "HTTP", "port": 18080 },
      { "connector": "HLS" },
      { "connector": "DTSC", "port": 14200 }
    ],
    "triggers": {
      "PLAY_REWRITE": [
        {
          "handler": "http://host.docker.internal:0/play-rewrite",
          "sync": true,
          "onfail": "deny",
          "streams": ["protected-replica", "blocked-replica"]
        }
      ],
      "STREAM_SOURCE": [
        {
          "handler": "/tmp/source-start-audit-hook.sh",
          "sync": true,
          "onfail": "offline",
          "streams": ["protected-replica", "blocked-replica"]
        }
      ],
      "USER_NEW": [
        {
          "handler": "/tmp/viewer-credentials-hook.sh",
          "sync": true,
          "onfail": "deny",
          "streams": ["protected-replica"]
        }
      ]
    }
  },
  "streams": {
    "origin": { "source": "/tmp/source.mp4" },
    "protected-replica": { "source": "dtsc://127.0.0.1:14200/origin" },
    "blocked-replica": { "source": "dtsc://127.0.0.1:14200/origin" }
  }
}
