{
  "config": {
    "device_discovery": false,
    "protocols": [
      { "connector": "HTTP", "port": 18080 },
      { "connector": "RTMP", "port": 1935 },
      { "connector": "TSSRT", "port": 8889 },
      { "connector": "HLS" }
