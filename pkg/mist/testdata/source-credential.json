{
  "config": {
    "device_discovery": false,
    "protocols": [
      {
        "connector": "HTTP",
        "port": 18080
      },
      {
        "connector": "HLS"
      },
      {
        "connector": "DTSC",
        "port": 14200
      }
    ],
    "triggers": {
      "CONN_PLAY": [
        {
          "handler": "/tmp/source-credential-hook.sh",
          "sync": true,
          "onfail": "deny",
          "streams": ["credential-origin"]
        }
      ]
    }
  },
  "streams": {
    "credential-origin": {
      "source": "/tmp/source.mp4"
    },
    "credential-replica": {
      "source": "dtsc://127.0.0.1:14200/credential-origin?token=fwsrc.two-cell-proof.CREDENTIAL"
    }
  }
}
